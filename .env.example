# ==========================================================
# B.L. DIAGNOSTIC CENTER — ENVIRONMENT CONFIGURATION
# Free Stack: Vercel + Render + PostgreSQL (Neon)
# ==========================================================

# ----------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ----------------------------------------------------------
# Set these in your Vercel Project Settings > Environment Variables

# Optional backend URL if running Express backend separately on Render:
VITE_API_URL="https://bl-diagnostic-backend.onrender.com"

# ----------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Render)
# ----------------------------------------------------------
# Set these in your Render Web Service Environment Settings
PORT=10000
NODE_ENV="production"
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres?sslmode=require&pgbouncer=true"
JWT_SECRET="bl_diagnostic_center_super_secure_jwt_random_secret_string_2026"

# ----------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL via Neon)
# ----------------------------------------------------------
# Uses Neon PostgreSQL serverless database
# Prisma ORM configured for database operations
