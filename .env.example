# ==========================================================
# B.L. DIAGNOSTIC CENTER — ENVIRONMENT CONFIGURATION
# Completely Free Stack: Vercel + Render + Supabase
# No Google Cloud Dependencies
# ==========================================================

# ----------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ----------------------------------------------------------
# Set these in your Vercel Project Settings > Environment Variables
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Also supported for Next.js deployments:
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Optional backend URL if running Express backend separately on Render:
VITE_API_URL="https://bl-diagnostic-backend.onrender.com"

# ----------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Render)
# ----------------------------------------------------------
# Set these in your Render Web Service Environment Settings
PORT=10000
NODE_ENV="production"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres?sslmode=require&pgbouncer=true"
JWT_SECRET="bl_diagnostic_center_super_secure_jwt_random_secret_string_2026"

# ----------------------------------------------------------
# 3. SUPABASE CONFIGURATION (PostgreSQL, Auth OTP, Storage)
# ----------------------------------------------------------
# Buckets required in Supabase Storage:
# - reports (Private, access via signed URLs)
# - user-documents (Private)
# - website-assets (Public)
#
# Authorized Administrator Phone: 9649183422
